# ==========================================
# Sthamly AI: environment variables ka example
# ==========================================
# Ye file sirf example hai. Asli values .env (ya .env.local) mein daalein, kabhi commit na karein.
# Worker ke liye: worker/ mein .dev.vars banayein (wrangler isse local par padhta hai).
# Worker ki non-secret vars (ALLOWED_ORIGINS, DAILY_BUDGET_INR, IMAGE_MODEL, etc.) worker/wrangler.toml mein hain.

# ==========================================
# 1. CORE APP, DATABASE & WORKER (ज़रूरी)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_APP_URL=https://your-app-domain.com
CRON_SECRET=your_random_secret_string_at_least_16_chars
ADMIN_USER_IDS=your_supabase_admin_user_uuid

# Worker ka encryption key (connector tokens aur guest IP hash ke liye). Worker mein wrangler secret se bhi set hota hai.
TOKEN_ENCRYPTION_KEY=your_random_32_byte_base64_key

# Job ki cost aur retry limit (paise aur count)
MAX_COST_PAISE_PER_JOB=1500
JOB_MAX_ATTEMPTS=2

# ==========================================
# 2. AI (Text, Voice, Cloudflare, Gemini, OpenRouter, Fal)
# ==========================================
TEXT_PROVIDER=groq
VOICE_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
GROQ_TEXT_MODEL=your_groq_text_model
GROQ_VOICE_MODEL=your_groq_voice_model

CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

GEMINI_API_KEY=your_gemini_api_key
GEMINI_LIVE_MODEL=your_gemini_live_model

OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=your_openrouter_model

FAL_KEY=your_fal_api_key

# ==========================================
# 3. PAYMENT (billing launch हो तो)
# ==========================================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ==========================================
# 4. CONNECTORS (Google Sheets रखना हो तो)
# ==========================================
# Ye key web (Next.js) side ke connector tokens ke liye hai. Worker wali TOKEN_ENCRYPTION_KEY se alag rakhein.
CONNECTOR_TOKEN_KEY=your_random_connector_key

# ==========================================
# 5. OTP: WHATSAPP (बिना DLT रजिस्ट्रेशन के)
# ==========================================
OTP_CHANNEL=whatsapp
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_whatsapp_phone_number_id
WHATSAPP_OTP_TEMPLATE=your_approved_auth_template_name
WHATSAPP_OTP_LANG=en
SEND_SMS_HOOK_SECRET=your_supabase_send_sms_hook_secret

# ==========================================
# 6. OTP: SMS via MSG91 (DLT रजिस्ट्रेशन के बाद, OTP_CHANNEL=sms रखें)
# ==========================================
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_OTP_TEMPLATE_ID=your_msg91_otp_template_id
MSG91_OTP_VAR=your_msg91_otp_variable_name

# ==========================================
# 7. MOBILE / DESKTOP SHELL APP (Vite)
# ==========================================
VITE_API_BASE=https://your-app-domain.com
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key