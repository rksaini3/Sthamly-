# ============================================================
# Sthamly: environment variables
# इसे .env.local में कॉपी करें: cp .env.example .env.local
# Vercel पर वही नाम Project Settings → Environment Variables में डालें।
# ============================================================

# ---- App ----
# local: http://localhost:3000 | production: https://app.sthamly.in (domain तय होने पर)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Supabase ----
# NEXT_PUBLIC_ वाले browser में जाते हैं, इसलिए उनमें कोई secret न रखें
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only: यह RLS bypass करता है। कभी commit न करें, कभी NEXT_PUBLIC_ न लगाएं
SUPABASE_SERVICE_ROLE_KEY=

# Supabase CLI के लिए (npm run db:push)
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# ---- WhatsApp Cloud API (Meta) ----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# webhook verify के लिए आप खुद कोई लंबा random string बनाएं
WHATSAPP_VERIFY_TOKEN=
# X-Hub-Signature-256 verify के लिए (Meta App की Settings से)
WHATSAPP_APP_SECRET=

# ---- AI provider ----
# मॉडल नाम और दाम official pricing page से verify करने के बाद ही भरें
AI_PROVIDER=fal
FAL_KEY=

# ---- Cron ----
# /api/cron/worker की सुरक्षा। कम से कम 16 अक्षर, random।
# Vercel Cron यही value Authorization header में भेजता है।
CRON_SECRET=

# ---- Limits ----
# एक job पर अधिकतम खर्च, paise में (1500 = ₹15)
MAX_COST_PAISE_PER_JOB=1500
JOB_MAX_ATTEMPTS=2

# ---- Billing (Phase 2) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Local scripts ----
TEST_WEBHOOK_URL=http://localhost:3000/api/webhook/whatsapp