/* Sthamly AI web: tasveer ka full-screen editor. Background hamesha gehra rehta hai (light ya dark theme se alag),
   taaki tasveer ke rang sahi dikhein. Buttons ka rang bhi isi ke hisaab se hai. */

.iv-root {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  flex-direction: column;
  background: rgb(0 0 0 / 0.94);
  color: #fff;
}

/* ---------- Upar: band karna, download, share ---------- */

.iv-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: calc(12px + env(safe-area-inset-top, 0px)) 16px 12px;
}

.iv-top-right {
  display: flex;
  align-items: center;
  gap: 8px;
}

.iv-btn {
  display: grid;
  place-items: center;
  width: 40px;
  height: 40px;
  padding: 0;
  border: none;
  border-radius: 50%;
  background: rgb(255 255 255 / 0.12);
  color: #fff;
  text-decoration: none;
}

.iv-btn:hover {
  background: rgb(255 255 255 / 0.2);
}

.iv-share {
  height: 40px;
  padding: 0 18px;
  border: none;
  border-radius: 999px;
  background: #fff;
  color: #000;
  font-size: 14px;
  font-weight: 600;
}

/* ---------- Beech: tasveer ---------- */

.iv-stage {
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8px 16px;
}

.iv-img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  border-radius: 12px;
}

.iv-note {
  margin: 0 16px 8px;
  text-align: center;
  font-size: 13px;
  color: rgb(255 255 255 / 0.85);
}

/* ---------- Size chunne ka panel (Resize ke baad) ---------- */

.iv-sizes {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8px;
  padding: 0 16px 8px;
}

.iv-size {
  padding: 8px 14px;
  border: 1px solid rgb(255 255 255 / 0.25);
  border-radius: 999px;
  background: transparent;
  color: #fff;
  font-size: 13px;
}

.iv-size:hover:not(:disabled) {
  background: rgb(255 255 255 / 0.12);
}

.iv-size:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* ---------- Neeche: औज़ार (Edit, Resize, Remove background, Markup) ---------- */

.iv-bottom {
  display: flex;
  justify-content: space-around;
  gap: 8px;
  padding: 12px 16px calc(16px + env(safe-area-inset-bottom, 0px));
}

.iv-tool {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  min-width: 64px;
  padding: 0;
  border: none;
  background: transparent;
  color: #fff;
}

.iv-tool:disabled {
  color: rgb(255 255 255 / 0.5);
  cursor: not-allowed;
}

.iv-tool-icon {
  display: grid;
  place-items: center;
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: rgb(255 255 255 / 0.12);
}

.iv-tool:not(:disabled):hover .iv-tool-icon,
.iv-tool.active .iv-tool-icon {
  background: rgb(255 255 255 / 0.22);
}

.iv-tool-label {
  font-size: 12px;
  text-align: center;
}

.iv-soon {
  position: absolute;
  top: -4px;
  right: 0;
  font-size: 10px;
  padding: 1px 6px;
  border-radius: 999px;
  background: rgb(255 255 255 / 0.2);
  color: #fff;
}

@media (prefers-reduced-motion: reduce) {
  .iv-btn {
    transition: none;
  }
}