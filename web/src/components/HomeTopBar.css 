/* Home header aur plan ki patti. Rang styles.css ke tokens se, light aur dark dono mein. */

.htb {
  display: flex;
  flex-direction: column;
  background: var(--bg);
  color: var(--text);
  border-bottom: 1px solid var(--border);
}

.htb-row {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 56px;
  padding: 0 16px;
}

.htb-title {
  flex: 1 1 auto;
  min-width: 0;
  margin: 0;
  font-size: 18px;
  font-weight: 700;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.htb-icon-btn {
  flex: 0 0 auto;
  width: 40px;
  height: 40px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 10px;
  background: transparent;
  color: var(--text);
  cursor: pointer;
}

.htb-icon-btn:disabled {
  opacity: 0.45;
  cursor: default;
}

.htb-credits {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  border-radius: 999px;
  background: var(--accent-bg);
  color: var(--accent-strong);
  font-size: 14px;
  font-weight: 600;
  text-decoration: none;
  white-space: nowrap;
}

.htb-sub {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  padding: 0 16px 10px;
}

.htb-plan {
  flex: 1 1 auto;
  min-width: 0;
  font-size: 14px;
  color: var(--muted);
}

.htb-chip {
  display: inline-flex;
  align-items: center;
  min-height: 34px;
  padding: 6px 14px;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: transparent;
  color: var(--text);
  font: inherit;
  font-size: 14px;
  text-decoration: none;
  white-space: nowrap;
}

.htb-chip-primary {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
}

.htb-icon-btn:focus-visible,
.htb-credits:focus-visible,
.htb-chip:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}